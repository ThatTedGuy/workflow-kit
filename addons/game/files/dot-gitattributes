# Line endings: every text file is LF, in Git and on disk, whatever Git's
# own autocrlf setting says. Windows cmd scripts need CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS: big binary files. Rules go by file type, not folder, so they
# work wherever a file lands. Every type here must also be on the asset
# list the license check uses (ExtraAssetExtensions in .claude/kit-settings.psd1
# for the engine's types). That list has more types, such
# as .svg, video, and libraries, which stay out of LFS. Run
# `git lfs install --local` once in a fresh clone.

# Models
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text

